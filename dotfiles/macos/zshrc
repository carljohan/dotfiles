typeset -U path PATH

# Interactive history.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt append_history share_history hist_ignore_all_dups hist_save_no_dups

# Small, portable defaults.
alias ll='ls -la'
alias c='cursor .'
alias reload='exec zsh -l'
alias zconf='cursor "$HOME/code/github.com/carljohan/dotfiles"'

yt-dlmp4() {
  yt-dlp --merge-output-format mp4 --postprocessor-args "ffmpeg:-preset veryfast" "$@"
}

autoload -Uz colors && colors
PROMPT='%F{cyan}%1~%f %# '

if [[ -t 1 ]]; then
  export GPG_TTY="$(tty)"
fi

# Activate the pinned toolchain before initializing the prompt from it.
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

typeset -U path PATH
path=("$HOME/.local/share/mise/shims" $path)
