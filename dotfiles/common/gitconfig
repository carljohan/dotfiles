[include]
    path = ~/.config/git/platform

[core]
    excludesfile = ~/.gitignore_global

[user]
    name = carljohan
    email = carljohan@hey.com

[github]
    user = carljohan

[alias]
    undo = reset --soft HEAD~

[push]
    autoSetupRemote = true
    default = current

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[color "diff-highlight"]
    oldNormal = "red bold"
    oldHighlight = "red bold 52"
    newNormal = "green bold"
    newHighlight = "green bold 22"

[rerere]
    enabled = true

[init]
    defaultBranch = main
